+    /**
+     * Whether a region owns at least one chunk.
+     */
+    public boolean enigma$hasContent(final ThreadedRegion<R, S> region) {
+        for (final ThreadedRegionSection<R, S> section : region.sectionByKey.values()) {
+            if (section.chunkCount > 0) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    /** Returns the configured merge-buffer radius in chunks. */
+    private int enigma$bufferRadiusChunks() {
+        return this.emptySectionCreateRadius * this.regionSectionChunkSize;
+    }
+
+    /**
+     * Returns true only when the configured square buffer zones around real loaded chunks
+     * overlap. For a radius of four, chunks eight coordinates apart are the last pair whose
+     * buffers still touch. Empty region sections, coupling and load are intentionally ignored.
+     */
+    private boolean enigma$bufferZonesOverlap(final ThreadedRegion<R, S> from, final ThreadedRegion<R, S> into) {
+        final int overlapReach = this.enigma$bufferRadiusChunks() * 2;
+        for (final ThreadedRegionSection<R, S> section : from.sectionByKey.values()) {
+            if (section.chunkCount <= 0) {
+                continue;
+            }
+            for (final long chunkKey : section.getChunks()) {
+                final int chunkX = CoordinateUtils.getChunkX(chunkKey);
+                final int chunkZ = CoordinateUtils.getChunkZ(chunkKey);
+                for (int dz = -overlapReach; dz <= overlapReach; ++dz) {
+                    for (int dx = -overlapReach; dx <= overlapReach; ++dx) {
+                        final int otherChunkX = chunkX + dx;
+                        final int otherChunkZ = chunkZ + dz;
+                        final ThreadedRegionSection<R, S> other = this.sections.get(CoordinateUtils.getChunkKey(
+                            otherChunkX >> this.sectionChunkShift, otherChunkZ >> this.sectionChunkShift
+                        ));
+                        if (other != null && other.getRegionPlain() == into
+                            && other.containsChunk(otherChunkX, otherChunkZ)) {
+                            return true;
+                        }
+                    }
+                }
+            }
+        }
+        return false;
+    }
+
+    /**
+     * Searches for the smallest section distance between two regions. Only the ring of the
+     * distance that is currently tested is inspected, so the search stays cheap even for regions
+     * with hundreds of sections.
+     */
+    private int enigma$distance(final ThreadedRegion<R, S> from, final ThreadedRegion<R, S> to,
+                                 final boolean fromMustHaveContent, final boolean toMustHaveContent) {
+        final int reach = this.enigma$mergeReach();
+        // The distance is symmetric, so the search always iterates over the smaller region.
+        // A region may own thousands of sections and this search runs on every chunk that
+        // lands in a section that was empty before.
+        ThreadedRegion<R, S> iter = from;
+        ThreadedRegion<R, S> other = to;
+        boolean iterMustHaveContent = fromMustHaveContent;
+        boolean otherMustHaveContent = toMustHaveContent;
+        if (iter.sectionByKey.size() > other.sectionByKey.size()) {
+            final ThreadedRegion<R, S> swap = iter;
+            iter = other;
+            other = swap;
+            final boolean swapContent = iterMustHaveContent;
+            iterMustHaveContent = otherMustHaveContent;
+            otherMustHaveContent = swapContent;
+        }
+        for (int distance = 0; distance <= reach; ++distance) {
+            if (this.enigma$hasNeighbour(iter, other, distance, iterMustHaveContent, otherMustHaveContent)) {
+                return distance;
+            }
+        }
+        return reach + 1;
+    }
+
+    /**
+     * Checks whether a section of {@code from} has a matching section in {@code to} at exactly the
+     * given Chebyshev distance.
+     */
+    private boolean enigma$hasNeighbour(final ThreadedRegion<R, S> from, final ThreadedRegion<R, S> to,
+                                         final int distance, final boolean fromMustHaveContent, final boolean toMustHaveContent) {
+        for (final ThreadedRegionSection<R, S> section : from.sectionByKey.values()) {
+            if (fromMustHaveContent && section.chunkCount <= 0) {
+                continue;
+            }
+            for (int dz = -distance; dz <= distance; ++dz) {
+                for (int dx = -distance; dx <= distance; ++dx) {
+                    if (Math.max(Math.abs(dx), Math.abs(dz)) != distance) {
+                        continue;
+                    }
+                    final ThreadedRegionSection<R, S> other =
+                        to.sectionByKey.get(CoordinateUtils.getChunkKey(section.sectionX + dx, section.sectionZ + dz));
+                    if (other == null) {
+                        continue;
+                    }
+                    if (toMustHaveContent && other.chunkCount <= 0) {
+                        continue;
+                    }
+                    return true;
+                }
+            }
+        }
+        return false;
+    }
+
+    /**
+     * Checks that every section a region owns is still within the given reach of the region's own
+     * loaded content. A region whose footprint has drifted away from its content covers unloaded
+     * ground and must not be grown any further.
+     */
+    public boolean enigma$footprintWithinReach(final ThreadedRegion<R, S> region, final int reach) {
+        int minX = Integer.MAX_VALUE;
+        int maxX = Integer.MIN_VALUE;
+        int minZ = Integer.MAX_VALUE;
+        int maxZ = Integer.MIN_VALUE;
+        boolean hasContent = false;
+        for (final ThreadedRegionSection<R, S> section : region.sectionByKey.values()) {
+            if (section.chunkCount <= 0) {
+                continue;
+            }
+            hasContent = true;
+            minX = Math.min(minX, section.sectionX);
+            maxX = Math.max(maxX, section.sectionX);
+            minZ = Math.min(minZ, section.sectionZ);
+            maxZ = Math.max(maxZ, section.sectionZ);
+        }
+        if (!hasContent) {
+            return true;
+        }
+        for (final ThreadedRegionSection<R, S> section : region.sectionByKey.values()) {
+            final int driftX = Math.max(minX - section.sectionX, section.sectionX - maxX);
+            final int driftZ = Math.max(minZ - section.sectionZ, section.sectionZ - maxZ);
+            if (Math.max(driftX, driftZ) > reach) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    /**
+     * The furthest apart two regions may be and still be merged into one. This mirrors the reach
+     * upstream Folia uses when it merges the regions around a freshly loaded chunk: the merge
+     * radius plus the buffer radius that surrounds the loaded chunks on either side.
+     */
+    public int enigma$mergeReach() {
+        return (2 * this.emptySectionCreateRadius) + this.regionSectionMergeRadius;
+    }
