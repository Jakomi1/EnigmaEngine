+    private double enigma$computeOverlap(final ThreadedRegion<R, S> a, final ThreadedRegion<R, S> b) {
+        ThreadedRegion<R, S> small = a;
+        ThreadedRegion<R, S> large = b;
+        if (small.sectionByKey.size() > large.sectionByKey.size()) {
+            final ThreadedRegion<R, S> swap = small;
+            small = large;
+            large = swap;
+        }
+        int boundary = 0;
+        int content = 0;
+        for (final ThreadedRegionSection<R, S> section : small.sectionByKey.values()) {
+            // Only a section that actually owns chunks may connect two regions. Empty buffer
+            // sections are created around a region's loaded chunks and stay behind when those
+            // chunks unload, so a whole chain of them can bridge two regions whose loaded
+            // content is hundreds of blocks apart. Counting them as a boundary made the
+            // regionizer merge those regions and built regions that span entire worlds.
+            if (section.chunkCount <= 0) {
+                continue;
+            }
+            ++content;
+            final int x = section.sectionX;
+            final int z = section.sectionZ;
+            for (int dz = -1; dz <= 1; ++dz) {
+                for (int dx = -1; dx <= 1; ++dx) {
+                    if ((dx | dz) == 0) {
+                        continue;
+                    }
+                    final ThreadedRegionSection<R, S> other =
+                        large.sectionByKey.get(CoordinateUtils.getChunkKey(x + dx, z + dz));
+                    if (other != null && other.chunkCount > 0) {
+                        ++boundary;
+                        break;
+                    }
+                }
+            }
+        }
+        if (boundary == 0 || content == 0) {
+            return 0.0D;
+        }
+        return Math.min(1.0D, (double) boundary / (double) content);
+    }
+
+    /**
+     * Returns the distance in region sections between the chunks that two regions own. Empty
+     * buffer sections are ignored on purpose: they only mark the edge of a region and may sit
+     * arbitrarily far away from the region's loaded content, so they must never be used to judge
+     * how close two regions are.
+     *
+     * @return the section distance, or {@code mergeReach() + 1} when the regions are further
+     *         apart than the reach allows
+     */
+    public int enigma$contentDistance(final ThreadedRegion<R, S> a, final ThreadedRegion<R, S> b) {
+        return this.enigma$distance(a, b, true, true);
+    }
+
+    /**
+     * Returns the distance in region sections between any section of {@code from} and the loaded
+     * content of {@code to}. Used when a chunk-less husk is folded into a neighbour: the husk
+     * itself owns no chunks, so only the neighbour's loaded content decides how far away the
+     * husk really is.
+     *
+     * @return the section distance, or {@code mergeReach() + 1} when the husk is further away
+     */
+    public int enigma$distanceToContentOf(final ThreadedRegion<R, S> from, final ThreadedRegion<R, S> to) {
+        return this.enigma$distance(from, to, false, true);
+    }
+
+    /**
+     * The distance that decides whether two regions may be merged. The distance is measured
+     * between the loaded chunks of the two regions. A region that owns no chunks at all (a husk)
+     * is measured by its sections, because a husk has no content that could be used as an
+     * anchor. Two regions that both own no chunks are only as close as their sections are.
+     *
+     * @return the section distance, or {@code mergeReach() + 1} when the regions are further
+     *         apart than the reach allows
+     */
+    public int enigma$mergeDistance(final ThreadedRegion<R, S> a, final ThreadedRegion<R, S> b) {
+        final boolean aHasContent = this.enigma$hasContent(a);
+        final boolean bHasContent = this.enigma$hasContent(b);
+        if (aHasContent && bHasContent) {
+            return this.enigma$distance(a, b, true, true);
+        }
+        if (aHasContent) {
+            return this.enigma$distance(b, a, false, true);
+        }
+        if (bHasContent) {
+            return this.enigma$distance(a, b, false, true);
+        }
+        return this.enigma$distance(a, b, false, false);
+    }
