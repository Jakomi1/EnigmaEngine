+    private double enigma$computeOverlap(final ThreadedRegion<R, S> a, final ThreadedRegion<R, S> b) {
+        ThreadedRegion<R, S> small = a;
+        ThreadedRegion<R, S> large = b;
+        if (small.sectionByKey.size() > large.sectionByKey.size()) {
+            final ThreadedRegion<R, S> swap = small;
+            small = large;
+            large = swap;
+        }
+        int boundary = 0;
+        for (final ThreadedRegionSection<R, S> section : small.sectionByKey.values()) {
+            final int x = section.sectionX;
+            final int z = section.sectionZ;
+            if (large.sectionByKey.containsKey(CoordinateUtils.getChunkKey(x - 1, z))
+                || large.sectionByKey.containsKey(CoordinateUtils.getChunkKey(x + 1, z))
+                || large.sectionByKey.containsKey(CoordinateUtils.getChunkKey(x, z - 1))
+                || large.sectionByKey.containsKey(CoordinateUtils.getChunkKey(x, z + 1))) {
+                ++boundary;
+            }
+        }
+        if (boundary == 0) {
+            return 0.0D;
+        }
+        return Math.min(1.0D, boundary / 4.0D);
+    }
