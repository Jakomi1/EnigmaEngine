+    /**
+     * A compact description of a region for the diagnostics. {@link ThreadedRegion#toString()}
+     * dumps every section including its chunk bitset, which produced multi megabyte log lines
+     * for the larger regions, so the diagnostics use this summary instead.
+     */
+    public String enigma$describe(final ThreadedRegion<R, S> region) {
+        int minX = Integer.MAX_VALUE;
+        int maxX = Integer.MIN_VALUE;
+        int minZ = Integer.MAX_VALUE;
+        int maxZ = Integer.MIN_VALUE;
+        int content = 0;
+        int chunks = 0;
+        for (final ThreadedRegionSection<R, S> section : region.sectionByKey.values()) {
+            minX = Math.min(minX, section.sectionX);
+            maxX = Math.max(maxX, section.sectionX);
+            minZ = Math.min(minZ, section.sectionZ);
+            maxZ = Math.max(maxZ, section.sectionZ);
+            if (section.chunkCount > 0) {
+                ++content;
+                chunks += section.chunkCount;
+            }
+        }
+        if (region.sectionByKey.isEmpty()) {
+            return "id=" + region.id + " secs=0";
+        }
+        return "id=" + region.id + " secs=" + region.sectionByKey.size() + " content=" + content
+            + " chunks=" + chunks + " bbox=[" + minX + ".." + maxX + "/" + minZ + ".." + maxZ + "]";
+    }
