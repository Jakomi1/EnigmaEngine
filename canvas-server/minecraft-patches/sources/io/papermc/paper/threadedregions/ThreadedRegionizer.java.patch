+        region.split(newRegionsMap, newRegionsSet);
+
+        for (final ThreadedRegion<R, S> newRegion : newRegionsSet) {
+            newRegion.state = ThreadedRegion.STATE_READY;
+            newRegion.onCreate();
+            this.callbacks.onRegionActive(newRegion);
+        }
+        return true;
+    }
