+        // Enigma start - regionizer driven eviction
+        // Force unloading the leftover chunks of idle regions lets them shrink back to their active footprint
+        // quickly so that fully idle regions can go inactive and stop consuming a tick thread.
+        if (settings.instantUnloadEnabled() && settings.instantUnloadMaxChunksPerPass() > 0) {
