+    // Enigma start - adaptive regionizer
+    private boolean enigma$shouldMerge(final ThreadedRegion<R, S> from, final ThreadedRegion<R, S> into) {
+        final io.canvasmc.canvas.regionizer.RegionizerSettings settings = this.world.enigma$regionizerSettings;
+        final boolean enigma$debugMerge = settings.debug();
+
+        // Hard prerequisite: the client-visible blue buffer zones must overlap.
+        if (!this.enigma$bufferZonesOverlap(from, into)) {
+            if (enigma$debugMerge) {
+                LOGGER.info("[MergeDebug] from={} secs={} into={} secs={} -> NO merge (buffer zones do not touch)",
+                    from.id, from.sectionByKey.size(), into.id, into.sectionByKey.size());
+            }
+            return false;
+        }
+
+        // FOLIA mode deliberately bypasses every Enigma merge policy, but never the buffer-zone invariant.
+        if (!io.canvasmc.canvas.regionizer.RegionizerMode.isAuto()) {
+            return true;
+        }
+        if (!settings.enabled()) {
+            // upstream behavior
+            return true;
+        }
+
+        final int mergeDistance = this.enigma$mergeDistance(from, into);
+        final int mergeReach = this.enigma$mergeReach() - 1;
+        if (mergeDistance > mergeReach) {
+            // The two regions are too far apart: merging them would create a single region that
+            // spans unloaded ground and ticks on one thread.
+            if (enigma$debugMerge) {
+                LOGGER.info("[MergeDebug] from={} secs={} into={} secs={} dist={} > reach={} -> NO merge (too far)",
+                    from.id, from.sectionByKey.size(), into.id, into.sectionByKey.size(), mergeDistance, mergeReach);
+            }
+            return false;
+        }
+
+        final double overlap = this.enigma$computeOverlap(from, into);
+

+        final long now = System.currentTimeMillis();
+
+        // Sibling lockout: regions produced by the same split must not be merged back into each
+        // other right away, otherwise the partitioner would immediately be undone by the merge
+        // logic.
+        if (from.enigma$partitionGroup != 0L && from.enigma$partitionGroup == into.enigma$partitionGroup
+            && now - from.enigma$lastSplitTime < settings.splitCooldownMillis()) {
+            if (enigma$debugMerge) {
+                LOGGER.info("[MergeDebug] from={} secs={} into={} secs={} -> NO merge (split siblings)",
+                    from.id, from.sectionByKey.size(), into.id, into.sectionByKey.size());
+            }
+            return false;
+        }
+
+        // Strict cooldown check on BOTH merges and splits to prevent split-merge oscillation
+        if (now - from.enigma$lastMergeTime < settings.mergeCooldownMillis()
+            || now - into.enigma$lastMergeTime < settings.mergeCooldownMillis()
+            || now - from.enigma$lastSplitTime < settings.splitCooldownMillis()
+            || now - into.enigma$lastSplitTime < settings.splitCooldownMillis()) {
+            return false;
+        }
+
+        // A merge should fill a region towards the active target, not create another oversized
+        // outlier that needs splitting again.
+        final int combinedSections = from.sectionByKey.size() + into.sectionByKey.size();
+        final int balancedMergeLimit = Math.max(2, Math.min(settings.splitMaxSections(), settings.targetSections()) - 4);
+        if (combinedSections > balancedMergeLimit) {
+            if (enigma$debugMerge) {
+                LOGGER.info("[MergeDebug] from={} secs={} into={} secs={} overlap={} combined={} > limit={} -> NO merge (size)",
+                    from.id, from.sectionByKey.size(), into.id, into.sectionByKey.size(),
+                    String.format("%.3f", overlap), combinedSections, balancedMergeLimit);
+            }
+            return false;
+        }
+
+        // At high aggression (>= 90%), preserve independent small regions down to 1 section
+        if (settings.aggression() >= 90) {
+            final double coupling = io.canvasmc.canvas.regionizer.RegionCoupling.getNormalized(from.id, into.id);
+            return coupling >= settings.mergeOverlapThreshold();
+        }
+
+        final double coupling = io.canvasmc.canvas.regionizer.RegionCoupling.getNormalized(from.id, into.id);
+        final double score = (settings.couplingWeight() * coupling) + (settings.overlapWeight() * overlap);
+
+        if (score >= settings.mergeOverlapThreshold()) {
+            return true;
+        }
+
+        return false;
+    }
