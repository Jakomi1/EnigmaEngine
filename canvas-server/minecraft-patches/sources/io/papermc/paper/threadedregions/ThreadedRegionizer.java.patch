+    // Enigma start - adaptive regionizer
+    private boolean enigma$shouldMerge(final ThreadedRegion<R, S> from, final ThreadedRegion<R, S> into) {
+        final io.canvasmc.canvas.regionizer.RegionizerSettings settings = this.world.enigma$regionizerSettings;
+        if (!settings.enabled()) {
+            // upstream behavior
+            return true;
+        }
+        // Buffer overlap is deliberately the sole merge criterion. Policy scores,
+        // cooldowns and section-shell contact must not make two regions merge earlier or later.
+        final boolean overlaps = this.enigma$bufferZonesOverlap(from, into);
+        if (settings.debug()) {
+            LOGGER.info("[MergeDebug] from={} into={} bufferRadius={} chunks -> {}",
+                from.id, into.id, this.enigma$bufferRadiusChunks(), overlaps ? "merge" : "separate");
+        }
+        return overlaps;
+    }
