+    public void enigma$runRegionMaintenance() {
+        if (!io.canvasmc.canvas.regionizer.RegionizerMode.isAuto()) {
+            return;
+        }
+
+        final io.canvasmc.canvas.regionizer.RegionizerSettings settings = this.world.enigma$regionizerSettings;
+        if (!settings.enabled()) {
+            return;
+        }
+
+        // Enigma start - regionizer driven eviction
+        // Disabled permanently: region statistics can be stale while a player is
+        // joining. Evicting based on that stale snapshot removes chunks which the
+        // player loader has just ticketed, leaving the client in an empty world.
+        if (false && settings.instantUnloadEnabled() && settings.instantUnloadMaxChunksPerPass() > 0) {
+            final List<ThreadedRegion<R, S>> candidates = new ArrayList<>();
+            this.computeForAllRegionsUnsynchronised(candidates::add);
+            final int idleRadius = settings.instantUnloadIdleRadius();
+            final int perRegionBudget = settings.instantUnloadMaxChunksPerPass();
+            final ca.spottedleaf.moonrise.patches.chunk_system.scheduling.ChunkTaskScheduler chunkTaskScheduler =
+                ((ca.spottedleaf.moonrise.patches.chunk_system.level.ChunkSystemServerLevel)this.world).moonrise$getChunkTaskScheduler();
+
+            for (final ThreadedRegion<R, S> region : candidates) {
+                if (region.isDead()) {
+                    continue;
+                }
+                if (!(region.data instanceof TickRegions.TickRegionData tickData)
+                    || tickData.getRegionStats().getChunkCount() == 0) {
+                    // region currently owns no chunks, nothing to evict
+                    continue;
+                }
+                // Entity migration is not implemented. A forced unload under an
+                // entity turns collision data into air while it is still ticking,
+                // which makes villagers and other mobs fall through the world.
+                // Only truly entity-free regions are safe eviction candidates.
+                if (tickData.getRegionStats().getEntityCount() != 0) {
+                    continue;
+                }
+                if (!settings.instantUnloadActiveRegions()
+                    && tickData.getRegionStats().getPlayerCount() != 0) {
+                    // only fully idle regions are evicted when active regions are disabled
+                    continue;
+                }
+
+                final boolean lock = this.writeLockOwner != Thread.currentThread();
+                if (lock) {
+                    this.regionLock.readLock();
+                }
+                long anchorSectionKey = -1L;
+                try {
+                    final LongIterator iterator = region.getOwnedSectionsUnsynchronised();
+                    if (iterator.hasNext()) {
+                        anchorSectionKey = iterator.nextLong();
+                    }
+                } finally {
+                    if (lock) {
+                        this.regionLock.tryUnlockRead();
+                    }
+                }
+                if (anchorSectionKey == -1L) {
+                    continue;
+                }
+
+                final int anchorChunkX = CoordinateUtils.getChunkX(anchorSectionKey) << this.sectionChunkShift;
+                final int anchorChunkZ = CoordinateUtils.getChunkZ(anchorSectionKey) << this.sectionChunkShift;
+                chunkTaskScheduler.scheduleChunkTask(anchorChunkX, anchorChunkZ, () -> {
+                    chunkTaskScheduler.chunkHolderManager.moonrise$forceUnloadRegionIdleChunks(idleRadius, perRegionBudget);
+                }, ca.spottedleaf.concurrentutil.util.Priority.IDLE);
+            }
+        }
+        // Enigma end - regionizer driven eviction
+    }
