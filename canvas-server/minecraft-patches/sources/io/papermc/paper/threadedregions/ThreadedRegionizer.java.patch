+    /**
+     * Merge decision for the case where a region would otherwise break the regionizer's
+    * adjacency invariant. A section that owns chunks must have all of its neighbouring
+    * sections in the same region, otherwise the access-radius box around the chunk crosses
+    * the region border and the chunk can never be scheduled. A required merge is only
+    * considered when the blue buffer zones overlap; then no policy, cooldown, or
+     * size limit may prevent it. The distance gate still applies to avoid distant merges.
+     */
+    private boolean enigma$shouldMergeRequired(final ThreadedRegion<R, S> from, final ThreadedRegion<R, S> into) {
+        if (!this.enigma$bufferZonesOverlap(from, into)) {
+            if (this.enigma$debug()) {
+                LOGGER.info("[MergeDebug] required from={} secs={} into={} secs={} -> NO merge (buffer zones do not touch)",
+                    from.id, from.sectionByKey.size(), into.id, into.sectionByKey.size());
+            }
+            return false;
+        }
+        if (!io.canvasmc.canvas.regionizer.RegionizerMode.isAuto() || !this.world.enigma$regionizerSettings.enabled()) {
+            return true;
+        }
+        final int mergeDistance = this.enigma$mergeDistance(from, into);
+        final int mergeReach = this.enigma$mergeReach();
+        if (mergeDistance > mergeReach) {
+            if (this.enigma$debug()) {
+                LOGGER.info("[MergeDebug] required from={} secs={} into={} secs={} dist={} > reach={} -> NO merge (too far)",
+                    from.id, from.sectionByKey.size(), into.id, into.sectionByKey.size(), mergeDistance, mergeReach);
+            }
+            return false;
+        }
+        return true;
+    }
