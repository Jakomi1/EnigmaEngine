+    /** Returns the configured merge-buffer radius in chunks. */
+    public int enigma$bufferRadiusChunks() {
+        try {
+            final io.papermc.paper.configuration.GlobalConfiguration global = io.papermc.paper.configuration.GlobalConfiguration.get();
+            if (global != null && global.threadedRegions != null) {
+                return Math.max(1, global.threadedRegions.bufferRadius);
+            }
+        } catch (final Throwable ignored) {
+        }
+        return 0;
