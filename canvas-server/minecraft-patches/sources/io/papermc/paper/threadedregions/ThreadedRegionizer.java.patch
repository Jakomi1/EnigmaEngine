+    private boolean enigma$shouldMerge(final ThreadedRegion<R, S> from, final ThreadedRegion<R, S> into) {
+        final io.canvasmc.canvas.regionizer.RegionizerSettings settings = this.world.enigma$regionizerSettings;
+        if (!settings.enabled()) {
+            // upstream behavior
+            return true;
+        }
+        if (from.sectionByKey.size() < settings.mergeMinRegionSections()) {
+            // regions smaller than this always merge to keep the regioniser stable
+            return true;
+        }
+        final long now = System.currentTimeMillis();
+        if (now - from.enigma$lastMergeTime < settings.mergeCooldownMillis()
+            || now - into.enigma$lastMergeTime < settings.mergeCooldownMillis()) {
+            return false;
+        }
+        final double coupling = io.canvasmc.canvas.regionizer.RegionCoupling.getNormalized(from.id, into.id);
+        final double overlap = this.enigma$computeOverlap(from, into);
+        final double score = (settings.couplingWeight() * coupling) + (settings.overlapWeight() * overlap);
+        return score >= settings.mergeOverlapThreshold();
+    }
+
+    private double enigma$computeOverlap(final ThreadedRegion<R, S> a, final ThreadedRegion<R, S> b) {
+        ThreadedRegion<R, S> small = a;
+        ThreadedRegion<R, S> large = b;
+        if (small.sectionByKey.size() > large.sectionByKey.size()) {
+            final ThreadedRegion<R, S> swap = small;
+            small = large;
+            large = swap;
+        }
+        int boundary = 0;
+        for (final ThreadedRegionSection<R, S> section : small.sectionByKey.values()) {
+            final int x = section.sectionX;
+            final int z = section.sectionZ;
+            if (large.sectionByKey.containsKey(CoordinateUtils.getChunkKey(x - 1, z))
+                || large.sectionByKey.containsKey(CoordinateUtils.getChunkKey(x + 1, z))
+                || large.sectionByKey.containsKey(CoordinateUtils.getChunkKey(x, z - 1))
+                || large.sectionByKey.containsKey(CoordinateUtils.getChunkKey(x, z + 1))) {
+                ++boundary;
+            }
+        }
+        if (boundary == 0) {
+            return 0.0D;
+        }
+        return Math.min(1.0D, boundary / 4.0D);
+    }
