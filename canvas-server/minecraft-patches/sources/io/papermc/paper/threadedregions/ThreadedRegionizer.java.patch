+    public void enigma$runRegionMaintenance() {
+        final io.canvasmc.canvas.regionizer.RegionizerSettings settings = this.world.enigma$regionizerSettings;
+        if (!settings.enabled()) {
+            return;
+        }
+
+        // Enigma start - regionizer driven eviction
+        // Disabled permanently: region statistics can be stale while a player is
+        // joining. Evicting based on that stale snapshot removes chunks which the
+        // player loader has just ticketed, leaving the client in an empty world.
+        if (false && settings.instantUnloadEnabled() && settings.instantUnloadMaxChunksPerPass() > 0) {
+            final List<ThreadedRegion<R, S>> candidates = new ArrayList<>();
+            this.computeForAllRegionsUnsynchronised(candidates::add);
+            final int idleRadius = settings.instantUnloadIdleRadius();
+            final int perRegionBudget = settings.instantUnloadMaxChunksPerPass();
+            final ca.spottedleaf.moonrise.patches.chunk_system.scheduling.ChunkTaskScheduler chunkTaskScheduler =
+                ((ca.spottedleaf.moonrise.patches.chunk_system.level.ChunkSystemServerLevel)this.world).moonrise$getChunkTaskScheduler();
+
+            for (final ThreadedRegion<R, S> region : candidates) {
+                if (region.isDead()) {
+                    continue;
+                }
+                if (!(region.data instanceof TickRegions.TickRegionData tickData)
+                    || tickData.getRegionStats().getChunkCount() == 0) {
+                    // region currently owns no chunks, nothing to evict
+                    continue;
+                }
+                // Entity migration is not implemented. A forced unload under an
+                // entity turns collision data into air while it is still ticking,
+                // which makes villagers and other mobs fall through the world.
+                // Only truly entity-free regions are safe eviction candidates.
+                if (tickData.getRegionStats().getEntityCount() != 0) {
+                    continue;
+                }
+                if (!settings.instantUnloadActiveRegions()
+                    && tickData.getRegionStats().getPlayerCount() != 0) {
+                    // only fully idle regions are evicted when active regions are disabled
+                    continue;
+                }
+
+                final boolean lock = this.writeLockOwner != Thread.currentThread();
+                if (lock) {
+                    this.regionLock.readLock();
+                }
+                long anchorSectionKey = -1L;
+                try {
+                    final LongIterator iterator = region.getOwnedSectionsUnsynchronised();
+                    if (iterator.hasNext()) {
+                        anchorSectionKey = iterator.nextLong();
+                    }
+                } finally {
+                    if (lock) {
+                        this.regionLock.tryUnlockRead();
+                    }
+                }
+                if (anchorSectionKey == -1L) {
+                    continue;
+                }
+
+                final int anchorChunkX = CoordinateUtils.getChunkX(anchorSectionKey) << this.sectionChunkShift;
+                final int anchorChunkZ = CoordinateUtils.getChunkZ(anchorSectionKey) << this.sectionChunkShift;
+                chunkTaskScheduler.scheduleChunkTask(anchorChunkX, anchorChunkZ, () -> {
+                    chunkTaskScheduler.chunkHolderManager.moonrise$forceUnloadRegionIdleChunks(idleRadius, perRegionBudget);
+                }, ca.spottedleaf.concurrentutil.util.Priority.IDLE);
+            }
+        }
+        // Enigma end - regionizer driven eviction
+
+        // Re-evaluate live regions on the maintenance cadence as well as on chunk release.
+        // A player entering a new area adds content rather than removing it, so release-only
+        // splitting left a large shared region intact until somebody later went away.
+        final List<ThreadedRegion<R, S>> splitCandidates = new ArrayList<>();
+        this.computeForAllRegionsUnsynchronised(splitCandidates::add);
+        this.acquireWriteLock();
+        try {
+            for (final ThreadedRegion<R, S> region : splitCandidates) {
+                if (region.isDead() || region.state != ThreadedRegion.STATE_READY
+                    || !region.mergeIntoLater.isEmpty() || !region.expectingMergeFrom.isEmpty()) {
+                    continue;
+                }
+                if (this.enigma$shouldSplit(region)) {
+                    this.enigma$splitRegion(region);
+                }
+            }
+        } finally {
+            this.releaseWriteLock();
+        }
+    }
+
+    /**
+     * Garbage collects regions that no longer own a single chunk so that no player-less region is
+     * left in the grid. Regions whose section shells are fully dead are released and dropped. A
+     * region that merely lost its chunks but still owns live boundary sections is folded into an
+     * idle, populated neighbour (absorbing the sections keeps the adjacency grid intact). Only
+     * structurally isolated husks fall through and are reported as retained. Runs entirely under
+     * the write lock, so the shared reads below are safe.
+     *
+     * @return the number of regions that were dropped
+     */
+    public int enigma$garbageCollectRegions() {
+        final io.canvasmc.canvas.regionizer.RegionizerSettings settings = this.world.enigma$regionizerSettings;
+        if (!settings.enabled()) {
+            return 0;
+        }
+        final List<ThreadedRegion<R, S>> snapshot = new ArrayList<>();
+        // Take an unsynchronised snapshot first so the write lock is only ever held while actually
+        // mutating. Dead or transient entries in the snapshot are re-checked under the lock.
+        this.computeForAllRegionsUnsynchronised(snapshot::add);
+
+        // Enigma start - skip the write lock when there is nothing to collect
+        // Only a ready, merge-free region that currently owns no chunks is worth collecting, and
+        // almost every pass finds none. Filter the snapshot first and never take the regionizer
+        // write lock in that case. The lock used to be taken on every tick (split-pass-interval-ticks
+        // defaults to 1), which forced every region tick thread that needed a read lock to stall and
+        // showed up as tick overruns at low CPU utilisation. These reads may be stale: anything kept
+        // is re-checked under the lock below, and anything missed is picked up on the next pass.
+        final List<ThreadedRegion<R, S>> candidates = new ArrayList<>();
+        for (final ThreadedRegion<R, S> region : snapshot) {
+            if (region.isDead() || region.state != ThreadedRegion.STATE_READY) {
+                continue;
+            }
+            if (!region.mergeIntoLater.isEmpty() || !region.expectingMergeFrom.isEmpty()) {
+                continue;
+            }
+            if (!region.getOwnedChunks().isEmpty()) {
+                continue;
+            }
+            candidates.add(region);
+        }
+        if (candidates.isEmpty()) {
+            return 0;
+        }
+        // Enigma end - skip the write lock when there is nothing to collect
+
+        int released = 0;
+        int absorbed = 0;
+        int retainedStructural = 0;
+        int retainedStructuralSections = 0;
+
+        this.acquireWriteLock();
+        try {
+            for (final ThreadedRegion<R, S> region : candidates) {
+                if (region.isDead() || region.state != ThreadedRegion.STATE_READY) {
+                    continue;
+                }
+                if (!region.mergeIntoLater.isEmpty() || !region.expectingMergeFrom.isEmpty()) {
+                    // A region with a pending merge is already on its way out of the grid.
+                    continue;
+                }
+
+                final int totalSections = region.sectionByKey.size();
+                final int deadSections = region.deadSections.size();
+                final boolean ownsChunks = !region.getOwnedChunks().isEmpty();
+                if (ownsChunks) {
+                    continue;
+                }
+
+                if (totalSections == 0 || deadSections == totalSections) {
+                    // Every section is dead or the region is a bare husk: let the normal release
+                    // machinery drain and drop it.
+                    try {
+                        this.onRegionRelease(region);
+                        released++;
+                        continue;
+                    } catch (final Throwable t) {
+                        LOGGER.warn("Region GC could not release fully-dead region {}: {}",
+                                region.id, t.toString());
+                    }
+                }
+
+                // Never use garbage collection to merge a shell into another region. A shell has
+                // no loaded chunks, therefore it has no buffer zone that could overlap. Folding it
+                // into a neighbour was an invisible third merge path and could reconnect two
+                // otherwise isolated player regions through stale empty sections.
+                retainedStructural++;
+                retainedStructuralSections += totalSections;
+            }
+        } finally {
+            this.releaseWriteLock();
+        }
+
+        if (released > 0) {
+            LOGGER.info("Region GC {}: released {} player-less region(s), absorbed {}, retained {} structural ({} boundary sections)",
+                    this.world.dimension().identifier().getPath(), released, absorbed, retainedStructural,
+                    retainedStructuralSections);
+        } else if (absorbed > 0 || retainedStructural > 0) {
+            // Absorbing a husk into a populated neighbour happens whenever a chunk unloads, which is
+            // far too often for INFO: keep it at debug so the console is not flooded.
+            LOGGER.debug("Region GC {}: released 0 player-less region(s), absorbed {}, retained {} structural ({} boundary sections)",
+                    this.world.dimension().identifier().getPath(), absorbed, retainedStructural,
+                    retainedStructuralSections);
+        }
+        return released;
+    }
+
+    /**
+     * Finds an idle neighbour region that a chunk-less region can be folded into. The neighbour
+     * must be live, ready and not ticking so the merge can run immediately while the write lock is
+     * held, and it must not already be part of a pending merge. Returns {@code null} when the
+     * region's sections are structurally isolated.
+     */
+    private ThreadedRegion<R, S> enigma$findAbsorbingRegion(final ThreadedRegion<R, S> region) {
+        for (final ThreadedRegionSection<R, S> section : region.sectionByKey.values()) {
+            final int sectionX = section.sectionX;
+            final int sectionZ = section.sectionZ;
+            for (int dz = -1; dz <= 1; ++dz) {
+                for (int dx = -1; dx <= 1; ++dx) {
+                    if ((dx | dz) == 0) {
+                        continue;
+                    }
+                    final ThreadedRegionSection<R, S> neighbour =
+                            this.sections.get(CoordinateUtils.getChunkKey(sectionX + dx, sectionZ + dz));
+                    if (neighbour == null) {
+                        continue;
+                    }
+                    final ThreadedRegion<R, S> neighbourRegion = neighbour.getRegionPlain();
+                    if (neighbourRegion == null || neighbourRegion == region || neighbourRegion.isDead()) {
+                        continue;
+                    }
+                    if (neighbourRegion.state != ThreadedRegion.STATE_READY || neighbourRegion.isTicking()) {
+                        continue;
+                    }
+                    if (neighbourRegion.mergeIntoLater.isEmpty() && neighbourRegion.expectingMergeFrom.isEmpty()) {
+                        // Only fold into a populated region: absorbing a player-less husk into another
+                        // player-less husk would just shuffle it around the grid on every pass.
+                        if (!neighbourRegion.getOwnedChunks().isEmpty()) {
+                            // Enigma start - an absorption must not bridge unloaded ground
+                            // A husk is folded into a neighbour that touches it in section space.
+                            // That neighbour's own footprint may however reach far past its
+                            // loaded chunks, and folding the husk into it would let a region grow
+                            // across a gap of unloaded sections one husk at a time. Only fold the
+                            // husk in when the neighbour's loaded content is still within reach and
+                            // when the neighbour's footprint has not already drifted away from its
+                            // own content.
+                            final int contentDistance = this.enigma$distanceToContentOf(region, neighbourRegion);
+                            final int reach = this.enigma$mergeReach();
+                            if (contentDistance > reach) {
+                                if (this.world.enigma$regionizerSettings.debug()) {
+                                    LOGGER.info("[MergeDebug] absorb {} -> {} refused: content distance {} exceeds reach {}",
+                                        region.id, neighbourRegion.id, contentDistance, reach);
+                                }
+                                continue;
+                            }
+                            if (!this.enigma$footprintWithinReach(neighbourRegion, reach)) {
+                                if (this.world.enigma$regionizerSettings.debug()) {
+                                    LOGGER.info("[MergeDebug] absorb {} -> {} refused: target footprint drifted from its content",
+                                        region.id, neighbourRegion.id);
+                                }
+                                continue;
+                            }
+                            // Enigma end - an absorption must not bridge unloaded ground
+                            return neighbourRegion;
+                        }
+                    }
+                }
+            }
+        }
+        return null;
+    }
+
+    private boolean enigma$shouldSplit(final ThreadedRegion<R, S> region) {
+        final io.canvasmc.canvas.regionizer.RegionizerSettings settings = this.world.enigma$regionizerSettings;
+        if (!settings.enabled()) {
+            return false;
+        }
+        // The inverse of the sole merge rule is also the sole split rule. Size, player count and
+        // tick time must not carve a still-overlapping buffer island into artificial regions:
+        // such children would immediately qualify for a merge again. As soon as the loaded
+        // content forms more than one non-overlapping buffer component, split without a cooldown.
