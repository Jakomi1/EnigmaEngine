+    /**
+     * Merge decision for the case where a region would otherwise break the regionizer's
+     * adjacency invariant. Every operating mode shares this one merge rule, including deferred
+     * paths: the configured buffer zones around real loaded chunks overlap.
+     */
+    private boolean enigma$shouldMergeRequired(final ThreadedRegion<R, S> from, final ThreadedRegion<R, S> into) {
+        return this.enigma$shouldMerge(from, into);
+    }
