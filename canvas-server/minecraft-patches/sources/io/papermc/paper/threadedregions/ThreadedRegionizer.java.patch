+    public void enigma$runRegionMaintenance() {
+        final io.canvasmc.canvas.regionizer.RegionizerSettings settings = this.world.enigma$regionizerSettings;
+        if (!settings.enabled()) {
+            return;
+        }
+        final List<ThreadedRegion<R, S>> candidates = new ArrayList<>();
+        this.computeForAllRegionsUnsynchronised(candidates::add);
+
+        for (final ThreadedRegion<R, S> region : candidates) {
+            if (region.isDead()) {
+                continue;
+            }
+            final boolean lock = this.writeLockOwner != Thread.currentThread();
+            if (lock) {
+                this.regionLock.readLock();
+            }
+            int sectionCount;
+            try {
+                sectionCount = region.sectionByKey.size();
+            } finally {
+                if (lock) {
+                    this.regionLock.tryUnlockRead();
+                }
+            }
+
+            final boolean hardSplit = sectionCount > settings.splitMaxSections();
+            if (!hardSplit) {
+                if (sectionCount < settings.splitMinSize()) {
+                    continue;
+                }
+                if (System.currentTimeMillis() - region.enigma$lastSplitTime < settings.splitCooldownMillis()) {
+                    continue;
+                }
+                double mspt = -1.0D;
+                if (region.data instanceof TickRegions.TickRegionData tickData) {
+                    mspt = tickData.getMSPT(io.canvasmc.canvas.region.RegionTickData.Frame._5_SECONDS);
+                }
+                if (mspt < settings.splitHighLoadMspt()) {
+                    continue;
+                }
+            }
+
+            this.acquireWriteLock();
+            try {
+                if (region.isDead() || region.state != ThreadedRegion.STATE_READY) {
+                    continue;
+                }
+                if (this.enigma$splitRegion(region)) {
+                    region.enigma$lastSplitTime = System.currentTimeMillis();
+                }
+            } finally {
+                this.releaseWriteLock();
+            }
+        }
