+    /**
+     * Uses the exact source chunks and loaded-chunk exclusion set from the client's blue overlay.
+     * Both are based on full-ready holders, not the broader set of chunks registered with regions.
+     */
+    public boolean enigma$bufferZonesOverlap(final ThreadedRegion<R, S> from, final ThreadedRegion<R, S> into) {
+        if (from == into) {
+            return false;
+        }
+        final Boolean publishedOverlap = io.canvasmc.canvas.chunkmap.EnigmaChunkMapService.publishedBufferZonesOverlap(
+            this.world, from.id, into.id);
+        if (Boolean.FALSE.equals(publishedOverlap)) {
+            if (this.enigma$debug()) {
+                LOGGER.info("[MergeDebug] from={} into={} -> NO merge (last client snapshot has no buffer overlap)",
+                    from.id, into.id);
+            }
+            return false;
+        }
+
+        final int radius = this.enigma$bufferRadiusChunks();
+        if (radius <= 0) {
+            return false;
+        }
+
+        final ca.spottedleaf.moonrise.patches.chunk_system.level.ChunkSystemServerLevel chunkSystemLevel =
+            (ca.spottedleaf.moonrise.patches.chunk_system.level.ChunkSystemServerLevel)this.world;
+        final java.util.List<ca.spottedleaf.moonrise.patches.chunk_system.scheduling.NewChunkHolder> holders =
+            chunkSystemLevel.moonrise$getChunkTaskScheduler().chunkHolderManager.getChunkHolders();
+        final it.unimi.dsi.fastutil.longs.LongOpenHashSet loadedChunks =
+            new it.unimi.dsi.fastutil.longs.LongOpenHashSet(holders.size());
+        final it.unimi.dsi.fastutil.longs.LongArrayList fromChunks = new it.unimi.dsi.fastutil.longs.LongArrayList();
+        final it.unimi.dsi.fastutil.longs.LongArrayList intoChunks = new it.unimi.dsi.fastutil.longs.LongArrayList();
+        for (final ca.spottedleaf.moonrise.patches.chunk_system.scheduling.NewChunkHolder holder : holders) {
+            if (!holder.isFullChunkReady()) {
+                continue;
+            }
+            final long key = CoordinateUtils.getChunkKey(holder.chunkX, holder.chunkZ);
+            loadedChunks.add(key);
+            final ThreadedRegion<R, S> owner = this.getRegionAtUnsynchronised(holder.chunkX, holder.chunkZ);
+            if (owner == from) {
+                fromChunks.add(key);
+            } else if (owner == into) {
+                intoChunks.add(key);
+            }
+        }
+        final boolean debug = this.enigma$debug();
+        final long[] overlapChunk = debug ? new long[1] : null;
+        final java.util.function.LongConsumer overlapConsumer = overlapChunk == null
+            ? null : (java.util.function.LongConsumer)(packed -> overlapChunk[0] = packed);
+        final boolean overlaps = io.canvasmc.canvas.chunkmap.EnigmaChunkMapService.bufferZonesOverlap(
+            loadedChunks.toLongArray(), fromChunks.toLongArray(), intoChunks.toLongArray(), radius, overlapConsumer);
+        if (overlaps && debug) {
+            LOGGER.info("[MergeDebug] buffer zones overlap from={} into={} publishedSnapshotOverlap={} at shared unloaded chunk=({}, {}) radius={}",
+                from.id, into.id, publishedOverlap, CoordinateUtils.getChunkX(overlapChunk[0]),
+                CoordinateUtils.getChunkZ(overlapChunk[0]), radius);
+        }
+        return overlaps;
+    }
