+    /**
+     * Garbage collects regions that no longer own a single chunk. Regions whose section shells are
+     * fully dead are released and dropped; regions that merely lost their chunks but still back the
+     * regionizer's adjacency grid (empty sections with alive, populated neighbours) are retained and
+     * reported as structural. Runs entirely under the write lock, so the shared reads below are safe.
+     *
+     * @return the number of regions that were dropped
+     */
+    public int enigma$garbageCollectRegions() {
+        final io.canvasmc.canvas.regionizer.RegionizerSettings settings = this.world.enigma$regionizerSettings;
+        if (!settings.enabled()) {
+            return 0;
+        }
+        final List<ThreadedRegion<R, S>> candidates = new ArrayList<>();
+        // Take an unsynchronised snapshot first so the write lock is only ever held while actually
+        // mutating. Dead or transient entries in the snapshot are re-checked under the lock.
+        this.computeForAllRegionsUnsynchronised(candidates::add);
+
+        int released = 0;
+        int retainedStructural = 0;
+        int retainedStructuralSections = 0;
+
+        this.acquireWriteLock();
+        try {
+            for (final ThreadedRegion<R, S> region : candidates) {
+                if (region.isDead() || region.state != ThreadedRegion.STATE_READY) {
+                    continue;
+                }
+
+                final int totalSections = region.sectionByKey.size();
+                final int deadSections = region.deadSections.size();
+                final boolean ownsChunks = !region.getOwnedChunks().isEmpty();
+                if (ownsChunks) {
+                    continue;
+                }
+
+                if (totalSections == 0 || deadSections == totalSections) {
+                    // Every section is dead or the region is a bare husk: let the normal release
+                    // machinery drain and drop it.
+                    try {
+                        this.onRegionRelease(region);
+                        released++;
+                        continue;
+                    } catch (final Throwable t) {
+                        LOGGER.warn("Region GC could not release fully-dead region {}: {}",
+                                region.id, t.toString());
+                    }
+                }
+
+                // The region kept alive, empty boundary sections that neighbouring regions
+                // rely on for adjacency. It is not garbage, just structural.
+                retainedStructural++;
+                retainedStructuralSections += totalSections;
+            }
+        } finally {
+            this.releaseWriteLock();
+        }
+
+        if (released > 0) {
+            LOGGER.info("Region GC {}: released {} empty region(s), retained {} structural ({} boundary sections)",
+                    this.world.dimension().identifier().getPath(), released, retainedStructural,
+                    retainedStructuralSections);
+        } else if (retainedStructural > 0) {
+            // Retaining boundary sections is the normal outcome, not news: this runs on a timer and
+            // at INFO it spams the log once per pass per world.
+            LOGGER.debug("Region GC {}: nothing to release, retained {} structural ({} boundary sections)",
+                    this.world.dimension().identifier().getPath(), retainedStructural,
+                    retainedStructuralSections);
+        }
+        return released;
+    }
