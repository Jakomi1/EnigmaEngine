+
+    // Canvas start - region threading
+    public static AABB clipAABBToOwnedRegion(final Level world, final AABB box) {
+        final Thread thread = Thread.currentThread();
+        final ThreadedRegionizer.ThreadedRegion<TickRegions.TickRegionData, TickRegions.TickRegionSectionData> region;
+        if (thread instanceof TickRegionScheduler.TickThreadRunner threadRunner) {
+            region = threadRunner.currentTickingRegion;
+        } else if (thread instanceof RegionShutdownThread shutdownThread) {
+            region = shutdownThread.shuttingDown;
+        } else {
+            region = null;
+        }
+        if (region == null) {
+            return box;
+        }
+        if (!(world instanceof net.minecraft.server.level.ServerLevel serverLevel) || serverLevel.regioniser != region.regioniser) {
+            return box;
+        }
+        return box;
+    }
+    // Canvas end - region threading
